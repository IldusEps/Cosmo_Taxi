unit Station;

interface
uses Classes,
  CastleUIState, CastleScene, CastleLog, SysUtils, CastleVectors, CastleTransform,
  CastleDebugTransform;

type

{ TStation }

TStation = class(TCastleScene)
public
  //Scene: TCastleScene; 
  RBody: TRigidBody;
  Collider: TBoxCollider;
  {parameters}
  IsNeedTaxi: Boolean;
  TypeStation: String;
  constructor Create(AOwner: TComponent; AScene: String; ATranslation: TVector2; Index: Integer);
end;

implementation


{ TStation }

constructor TStation.Create(AOwner: TComponent; AScene: String;
  ATranslation: TVector2; Index: Integer);
var
  Debug: TDebugTransform;
begin
  inherited Create(AOwner);

  Load(AScene);
  Setup2D;
  TranslationXY:= ATranslation;
  Translation.Z:= 2;
  Scale:= Vector3(4, 4, 1);
  Name:= 'Asteroid' + IntToStr(Index);

  RBody := TRigidBody.Create(Self);
  RBody.Gravity:= False;
  RBody.Dynamic:= True;
  RBody.Trigger:= True;
  RBody.Setup2D;

  Collider := TBoxCollider.Create(RBody);
  Collider.Size := Vector3(LocalBoundingBox.Size.XY, 20);

  RigidBody := RBody;

  Debug := TDebugTransform.Create(Self);
  Debug.Attach(Self);
  Debug.Exists := true;
end;

end.
