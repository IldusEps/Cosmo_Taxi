unit Station;

interface
uses Classes,
  CastleUIState, CastleScene, CastleLog, SysUtils, CastleVectors, CastleTransform,
  CastleDebugTransform, CastleImages, CastleGLImages, CastleUIControls, CastleControls,
  Math;

type

{ TStation }

TStation = class(TCastleScene)
private              
  {parameters}
  AIsNeedTaxi, AIsDestination: Boolean;
  ATypeStation: String;
  procedure SetIsDestination(AValue: Boolean);
  procedure SetIsNeedTaxi(AValue: Boolean);
  procedure SetTypeStation(AValue: String);
public
  RBody: TRigidBody;
  Collider: TBoxCollider;
  CaptionStation: String;
  {Radar}
  mini: TCastleImageControl;

  Price: Integer;
  property TypeStation: String read ATypeStation write SetTypeStation;
  property IsNeedTaxi: Boolean read AIsNeedTaxi write SetIsNeedTaxi;
  property IsDestination: Boolean read AIsDestination write SetIsDestination;

  constructor Create(AOwner: TComponent; AScene: String; ATranslation: TVector2; Index: Integer; BIsNeedTaxi: Boolean = False);
  function GenerateAsteroidName(Index: Integer): String;
end;

implementation


{ TStation }

procedure TStation.SetIsDestination(AValue: Boolean);
begin
  if AIsDestination = AValue then Exit;

  if AValue then
  begin
    mini.URL:= 'castle-data:/radar/Destination_mini.png';
    Price:= Random() + 500;
  end
  else
    SetTypeStation(TypeStation);
  AIsDestination:= AValue;
end;

procedure TStation.SetIsNeedTaxi(AValue: Boolean);
begin
  if AIsNeedTaxi = AValue then Exit;

  if AValue then
    AutoAnimation:= 'IsNeedTaxi'
  else
    AutoAnimation:= 'IsNotNeedTaxi';
  AIsNeedTaxi:= AValue;
end;

procedure TStation.SetTypeStation(AValue: String);
begin
  if ATypeStation = AValue then Exit;

  if IsDestination = false then
    case AValue of
      'Fill': mini.URL:= 'castle-data:/radar/Fill_mini.png';
      'Boots': mini.URL:= 'castle-data:/radar/Boots_mini.png';
      else
        mini.URL:= 'castle-data:/radar/Asteroid_mini.png';
    end;
  ATypeStation:= AValue;
end;

constructor TStation.Create(AOwner: TComponent; AScene: String;
  ATranslation: TVector2; Index: Integer; BIsNeedTaxi: Boolean);
var
  Debug: TDebugTransform;
begin
  inherited Create(AOwner);

  Load(AScene);
  Setup2D;
  TranslationXY:= ATranslation;
  Translation.Z:= 2;
  Scale:= Vector3(4, 4, 1);
  Name:= 'Asteroid' + IntToStr(Index);
  CaptionStation:= GenerateAsteroidName(Index);

  IsNeedTaxi:= AIsNeedTaxi;
  AIsDestination:= False;
  AutoAnimationLoop:= True;
  AnimateSkipTicks:= 15;

  RBody := TRigidBody.Create(Self);
  RBody.Gravity:= False;
  RBody.Dynamic:= True;
  RBody.Trigger:= True;
  RBody.Setup2D;

  Collider := TBoxCollider.Create(RBody);
  Collider.Size := Vector3(BoundingBox.Size.XY, 20);

  RigidBody := RBody;

  Debug := TDebugTransform.Create(Self);
  Debug.Attach(Self);
  Debug.Exists := true;

  {Radar}
  mini:= TCastleImageControl.Create(Self);
  case TypeStation of
    'Fill': mini.URL:= 'castle-data:/Fill_mini.png';
    'Boots': mini.URL:= 'castle-data:/Boots_mini.png';
    else
      mini.URL:= 'castle-data:/radar/Asteroid_mini.png';
  end;
  mini.Width:= 10;
  mini.Height:= 10;
end;

function TStation.GenerateAsteroidName(Index: Integer): String;
var
  Word: String;
begin                          
  Randomize;
  Word:= Chr(65 + Round(Random(26)));
  Result:= Word + '_' + IntToStr(Round(Abs(RandG((Index.ToDouble)/200, 99.0))));
  WritelnLog(Result);
end;

end.
